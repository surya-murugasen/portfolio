# ==============================================================
# Environment Configuration for Portfolio AI Assistant
# Keep this file secure and NEVER commit the real .env to git
# ==============================================================

# LLM Provider Key (Google Gemini 1.5 Flash / 2.0 Flash)
# Obtain a free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Server Port
PORT=8000

# Rate Limiting Configuration
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Production Allowed Origin (Override if custom domain is used)
ALLOWED_ORIGIN=https://surya-murugasen-portfolio-5f4d33.netlify.app
